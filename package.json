{
  "name": "shopify-dashboard",
  "version": "2.0.0",
  "description": "Self-hosted dashboard for Shopify app developers — tracks installs, uninstalls and active stores per app, and drives email flows, sequences and campaigns off those events.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/metizror/shopify-dashboard-frontend.git"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "backfill:shop-domains": "tsx scripts/backfill-shop-domains.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "dotenv": "^16.4.5",
    "postcss": "^8.5.14",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
