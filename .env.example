# Copy this file to .env and fill in the values. .env is gitignored — never
# commit real credentials.
#
#   cp .env.example .env
#
# Rule for this project: no secret may ever reach the browser, which means no
# NEXT_PUBLIC_ variable may hold one. Next.js inlines every NEXT_PUBLIC_* into
# the client JS bundle, where anyone can read it straight out of devtools.
#
# Only the four variables in "Required" are needed to boot. Everything else the
# app needs — Shopify Partner tokens, the email provider and its credentials,
# sender addresses, alert recipients, per-app API endpoints — is added through
# the UI and stored in the database, not here, because those are lists that
# grow and change without a redeploy.


# ═══ Required ══════════════════════════════════════════════════════════════

# MySQL connection string. The database must exist; run `npx prisma migrate deploy`
# to create the tables.
DATABASE_URL=mysql://user:password@localhost:3306/shopify_dashboard

# HMAC key that signs the httpOnly session cookie issued at login. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates every session and logs all users out.
SESSION_SECRET=

# Shared secret for server-to-server callers — cron jobs, scripts, curl — which
# send it as the `x-dashboard-password` header. Browsers never use it; they
# authenticate with the session cookie. Any long random string works.
DASHBOARD_PASSWORD=

# Public base URL of this installation, no trailing slash. Used to build the
# unsubscribe and open/click tracking links embedded in outgoing email, so a
# wrong value silently breaks unsubscribe for every recipient.
#   local:      http://localhost:3000
#   production: https://dashboard.example.com
DASHBOARD_BASE_URL=http://localhost:3000


# ═══ Optional ══════════════════════════════════════════════════════════════

# ── Email ──────────────────────────────────────────────────────────────────
#
# EMAIL IS NOT CONFIGURED HERE. Open Settings → Email in the running app and
# choose one of two transports:
#
#   Brevo   paste an API key (Brevo → SMTP & API → API Keys). The page can
#           then import the senders registered on that account.
#   SMTP    host, port, username, password for any server — Gmail, Zoho,
#           Postmark, your own relay. Implicit TLS off for 587, on for 465.
#
# Both sets of credentials are stored side by side and the radio button picks
# the live one, so switching back after a test costs nothing. Each can also be
# replaced or removed from that page. Everything lives in the database, which
# is why a new install never edits this file to start sending.
#
# The FROM-ADDRESS is not set here either. Every message goes out as the
# default sender under Settings → Email → Senders. (EMAIL_FROM_ALERTS and
# EMAIL_FROM_HELLO used to override it from here and no longer exist — if your
# .env still has them, they are inert and can be deleted.) With no sender row
# at all, sends are skipped with "no sender configured" rather than going out
# from some arbitrary address.

# Brevo API key — a FALLBACK, read only when no Brevo key has been saved under
# Settings → Email. It exists so a deployment that predates that page keeps
# sending after an upgrade. On a new install, leave it empty and use the UI;
# on a dev machine leave it empty full stop, so an accidental send fails
# instead of mailing real merchants.
BREVO_API_KEY=

# Display name used in email signatures and as the sender name.
BRAND_NAME=

# Where "Unsubscribe" links point. Defaults to your default sender — set this
# only to route opt-outs to a separate mailbox.
EMAIL_UNSUBSCRIBE=

# Demo/booking link (Calendly or similar) offered in merchant-facing email.
# Leave EMPTY and the "Book a demo" button is omitted entirely rather than
# rendered pointing nowhere.
BOOKING_URL=


# ── Server ─────────────────────────────────────────────────────────────────

# IANA timezone used to render every date in the UI and in emails, and to decide
# what "today" and a scheduled "9:00 am" mean. Defaults to UTC when unset.
# Examples: Asia/Kolkata, America/New_York, Europe/London
# Read by the browser as well as the server, so it is baked in at build time —
# rebuild (`npm run build`) after changing it, not just restart.
TZ_DISPLAY=UTC

# HTTP port for `npm start` in production. Defaults to 3000.
PORT=3000


# ── Background jobs ────────────────────────────────────────────────────────
#
# The app schedules its own jobs in-process (see instrumentation.ts) — no
# external cron daemon needed. Polling every 5 minutes is what keeps installs
# and uninstalls arriving without you pressing Sync.
#
# On in production, off under `npm run dev`. Set it explicitly to override:
#   true   — run the scheduler even in development (calls the real Partner API
#            and sends real email — set EMAIL_REDIRECT_TO below, or leave email
#            unconfigured under Settings → Email, while testing)
#   false  — never schedule. Set this on every instance but one if you run
#            several (pm2 cluster mode, multiple replicas), or each will
#            duplicate every job.
ENABLE_CRON=

# Lets an external scheduler call /api/cron/poll-events and
# /api/cron/replay-installs directly, as `Authorization: Bearer <secret>`.
# Only needed if you drive those routes from outside instead of using the
# built-in scheduler above.
#
# Leaving it EMPTY does not close the routes — they still accept
# `x-dashboard-password`, so they are never open to the public — it just means
# the Bearer path is unavailable.
CRON_SECRET=


# ── Internal alerts ────────────────────────────────────────────────────────
#
# Where install/uninstall notifications go — your own team, not merchants.
# Comma-separated. Can also be set in the UI under Email → Settings, which
# takes precedence; this is the fallback used before anything is saved there.
EMAIL_TO=

# Development safety net. When set, EVERY outgoing email goes to this one
# address instead of its real recipients, and the intended recipients are
# prepended to the subject so a test is still readable.
#
# A dev machine usually points at a copy of production data, so a flow that
# fires by accident mails real merchants from a laptop. This makes that
# impossible. Set it to your own address while working locally.
#
# LEAVE IT EMPTY IN PRODUCTION — with a value set, nobody receives their mail.
# Every redirected send is logged, so grep the logs for "redirect active" if
# real recipients stop getting email.
EMAIL_REDIRECT_TO=

# The built-in install/uninstall alert emails are OFF unless this is exactly
# `true`. They were disabled in favour of driving the same notifications
# through Flows, which are editable in the UI. Set it to `true` if you would
# rather have the hardcoded alerts back.
BUILTIN_APP_ALERTS_ENABLED=


# ── Sequence reply detection (Zoho Mail) ───────────────────────────────────
#
# Optional and off unless all of CLIENT_ID, CLIENT_SECRET and REFRESH_TOKEN are
# set. When configured, the app reads your inbox and stops a sequence for any
# merchant who has replied, so nobody keeps getting drip email after answering.
# Without it, sequences run to completion regardless of replies.
#
# Create a Self Client at api-console.zoho.com and generate a refresh token for
# the ZohoMail.messages.READ scope.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Which mailbox to read. Find it at mail.zoho.com → Settings → Mail Accounts.
ZOHO_ACCOUNT_ID=

# Zoho is region-partitioned and the wrong host returns "invalid token" rather
# than a redirect. Change both to match your account: .in, .eu, .com.au, .jp
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
ZOHO_MAIL_HOST=https://mail.zoho.com

# Shared secrets for the two webhook endpoints. These are the only routes that
# must answer without a login — the callers are external services with no cookie
# jar — so a token is the only thing authenticating them. Callers send it as
# `?token=<secret>` or an `x-webhook-token` header.
#
# Leaving either EMPTY accepts every request, which is what makes them optional:
# deploy, update the caller to send the token, then set the value to enforce.
# Set both in production. Without them, anyone who knows the URL can post fake
# install/uninstall events that persist to your database and email your merchants.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PARTNER_WEBHOOK_SECRET=
BREVO_WEBHOOK_SECRET=


# ═══ Not configured here ═══════════════════════════════════════════════════
#
# These are deliberately NOT environment variables — add them in the app:
#
#   Shopify Partner API token   Shopify → Partners → "Add partner". Stored per
#                               partner org, so one install can track several.
#                               Create the token at
#                               partners.shopify.com → Settings → Partner API clients.
#
#   Email provider              Settings → Email. Brevo API key or SMTP
#                               credentials, stored in the database, editable
#                               and removable from that page.
#
#   Sender addresses            Settings → Email → Senders. Brevo can import
#                               the senders on your account; SMTP cannot list
#                               anything, so type the address in. Either way an
#                               address the provider has not verified is saved
#                               with a warning rather than refused — aliases
#                               and domain relays are legitimate — but the
#                               provider may still reject it at send time.
#                               The row marked default is the from-address for
#                               everything; a per-flow or per-campaign sender
#                               overrides it.
#
#   Alert recipients            Settings → Email, or Email → Settings. Who gets
#                               install/uninstall notices. EMAIL_TO below is
#                               only the fallback until you save a list.
#
#   Per-app shop-lookup APIs    Shopify → Apps → an app → Endpoint. Optional;
#                               only needed to attach merchant details to
#                               uninstall records.
#
#   Dashboard users             There is no sign-up page. Create the first
#                               account from the command line before you can log
#                               in at all — see Part 8 of the README:
#                                 npx tsx scripts/set-password.ts \
#                                   you@example.com 'password' --role admin
